{
  "opencollection": "1.0.0",
  "info": {
    "name": "Earnipay Invoicing App Products API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Products",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get products list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/products",
            "params": [
              {
                "name": "businessId",
                "value": "",
                "type": "query",
                "description": "Business ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Items per page (max 100)"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search in name, description"
              },
              {
                "name": "taxCategory",
                "value": "",
                "type": "query",
                "description": "Filter by tax category"
              },
              {
                "name": "isActive",
                "value": "",
                "type": "query",
                "description": "Filter by active status"
              },
              {
                "name": "dateFrom",
                "value": "",
                "type": "query",
                "description": "Filter by creation date from (YYYY-MM-DD)"
              },
              {
                "name": "dateTo",
                "value": "",
                "type": "query",
                "description": "Filter by creation date to (YYYY-MM-DD)"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Sort field"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query",
                "description": "Sort order"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve paginated list of products with search, filter, and sort capabilities."
        },
        {
          "info": {
            "name": "Create new product",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/products",
            "params": [
              {
                "name": "businessId",
                "value": "",
                "type": "query",
                "description": "Business ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new product for the current business. Product names must be unique per business."
        },
        {
          "info": {
            "name": "Get product details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/products/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Product ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve detailed information about a specific product."
        },
        {
          "info": {
            "name": "Update product",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/products/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Product ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update product information. Product name must remain unique per business."
        },
        {
          "info": {
            "name": "Delete product",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/products/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Product ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Soft delete a product. The product will no longer appear in your catalog."
        }
      ]
    }
  ],
  "bundled": true
}