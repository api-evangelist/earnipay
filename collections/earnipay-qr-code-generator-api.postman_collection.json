                        "type": "text/plain"
                      },
                      "key": "cryptoKeysFile",
                      "value": "<binary>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "QR code error correction level (H = High 30% recovery, recommended) (This can only be one of L,M,Q,H)",
                        "type": "text/plain"
                      },
                      "key": "errorCorrectionLevel",
                      "value": "H",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "QR code width in pixels (FIRS requires minimum 300x300)",
                        "type": "text/plain"
                      },
                      "key": "width",
                      "value": "300",
                      "type": "text"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
